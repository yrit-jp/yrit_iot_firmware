%%{init:{
	'theme':'default',
	'flowchart': {
		'curve': 'basis',
        'htmlLabels':'false',
        'fontSize': '10px'
		}
	}
}%%

flowchart TD
    subgraph  
    direction TB
    Start([定期タイマー])
    FetchData[センサデータ取得処理]
    Success{取得成功？}
    Store[データを<br/>送信バッファに格納]
    Error[取得をスキップ]
    Next{次のセンサ<br/>がある？}
    Wait[次の定期タイマー<br/>まで待機]

    Start --> FetchData
    FetchData --> Success
    Success -->|成功| Store
    Success -->|失敗| Error
    Store --> Next
    Error --> Next
    Next -->|あり| FetchData
    Next -->|なし| Wait
    Wait --> Start
    end

